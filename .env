# Base URL for API requests.
# In local development (Vite dev server) and production on Vercel (via vercel.json rewrites),
# leaving this blank allows same-domain /api proxying to handle requests cleanly without CORS.
# If you want to connect directly across domains without rewrites:
# VITE_API_URL=https://contracthubpk-backend-3.vercel.app
VITE_API_URL=
